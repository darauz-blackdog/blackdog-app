<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_bd_app_payment_list" model="ir.ui.view">
        <field name="name">blackdog.app.payment.list</field>
        <field name="model">blackdog.app.payment</field>
        <field name="arch" type="xml">
            <list string="Pagos App"
                  decoration-success="state == 'paid'"
                  decoration-info="state == 'pending'"
                  decoration-danger="state in ('failed','expired')"
                  decoration-warning="state == 'refunded'">
                <field name="name"/>
                <field name="app_order_id"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'pending'"
                       decoration-danger="state in ('failed','expired')"
                       decoration-warning="state == 'refunded'"/>
                <field name="external_ref" optional="show"/>
                <field name="paid_date"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_bd_app_payment_form" model="ir.ui.view">
        <field name="name">blackdog.app.payment.form</field>
        <field name="model">blackdog.app.payment</field>
        <field name="arch" type="xml">
            <form string="Pago App">
                <header>
                    <button name="action_mark_paid" string="Marcar Pagado"
                            type="object" class="btn-success"
                            invisible="state != 'pending'"
                            groups="blackdog_app_sales.group_app_sales_manager"/>
                    <button name="action_mark_failed" string="Marcar Fallido"
                            type="object" class="btn-danger"
                            invisible="state != 'pending'"
                            groups="blackdog_app_sales.group_app_sales_manager"/>
                    <button name="action_refund" string="Reembolsar"
                            type="object" class="btn-warning"
                            invisible="state != 'paid'"
                            groups="blackdog_app_sales.group_app_sales_manager"
                            confirm="¿Seguro que desea reembolsar este pago?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pago">
                            <field name="app_order_id"/>
                            <field name="payment_method"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="paid_date"/>
                        </group>
                        <group string="Referencia Externa">
                            <field name="external_ref"/>
                            <field name="external_url" widget="url"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group string="Respuesta Gateway" invisible="not raw_response">
                        <field name="raw_response" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_bd_app_payment_search" model="ir.ui.view">
        <field name="name">blackdog.app.payment.search</field>
        <field name="model">blackdog.app.payment</field>
        <field name="arch" type="xml">
            <search string="Pagos App">
                <field name="name"/>
                <field name="app_order_id"/>
                <field name="partner_id"/>
                <field name="external_ref"/>
                <separator/>
                <filter string="Pendientes" name="filter_pending"
                        domain="[('state','=','pending')]"/>
                <filter string="Pagados" name="filter_paid"
                        domain="[('state','=','paid')]"/>
                <filter string="Fallidos" name="filter_failed"
                        domain="[('state','in',['failed','expired'])]"/>
                <filter string="Reembolsados" name="filter_refunded"
                        domain="[('state','=','refunded')]"/>
                <separator/>
                <filter string="Tilopay" name="filter_tilopay"
                        domain="[('payment_method','=','tilopay')]"/>
                <filter string="Yappy" name="filter_yappy"
                        domain="[('payment_method','=','yappy')]"/>
                <filter string="Efectivo" name="filter_cash"
                        domain="[('payment_method','=','cash')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Método" name="group_method"
                            context="{'group_by': 'payment_method'}"/>
                    <filter string="Fecha Pago" name="group_date"
                            context="{'group_by': 'paid_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_bd_app_payments_awaiting" model="ir.actions.act_window">
        <field name="name">Esperando Pago</field>
        <field name="res_model">blackdog.app.payment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="search_view_id" ref="view_bd_app_payment_search"/>
    </record>

    <record id="action_bd_app_payments_all" model="ir.actions.act_window">
        <field name="name">Todos los Pagos</field>
        <field name="res_model">blackdog.app.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bd_app_payment_search"/>
    </record>

</odoo>
