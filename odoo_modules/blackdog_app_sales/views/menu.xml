<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Top-level menu under Sales -->
    <menuitem id="menu_app_sales_root"
              name="App Móvil"
              parent="sale.sale_menu_root"
              sequence="5"
              groups="blackdog_app_sales.group_app_sales_manager,blackdog_app_sales.group_app_branch_operator"/>

    <!-- ─── Pedidos ──────────────────────────────────────────── -->
    <menuitem id="menu_app_orders"
              name="Pedidos"
              parent="menu_app_sales_root"
              sequence="10"/>

    <menuitem id="menu_app_orders_pending"
              name="Pedidos Pendientes"
              parent="menu_app_orders"
              action="action_bd_app_orders"
              sequence="10"/>

    <menuitem id="menu_app_orders_all"
              name="Todos los Pedidos"
              parent="menu_app_orders"
              action="action_bd_app_orders_all"
              sequence="20"/>

    <menuitem id="menu_app_order_queue"
              name="Cola de Importación"
              parent="menu_app_orders"
              action="action_bd_app_order_queue"
              sequence="30"
              groups="blackdog_app_sales.group_app_sales_manager"/>

    <!-- ─── Pagos ────────────────────────────────────────────── -->
    <menuitem id="menu_app_payments"
              name="Pagos"
              parent="menu_app_sales_root"
              sequence="15"/>

    <menuitem id="menu_app_payments_awaiting"
              name="Esperando Pago"
              parent="menu_app_payments"
              action="action_bd_app_payments_awaiting"
              sequence="10"/>

    <menuitem id="menu_app_payments_all"
              name="Todos los Pagos"
              parent="menu_app_payments"
              action="action_bd_app_payments_all"
              sequence="20"/>

    <!-- ─── Dashboard ────────────────────────────────────────── -->
    <menuitem id="menu_app_dashboard"
              name="Dashboard"
              parent="menu_app_sales_root"
              sequence="20"/>

    <menuitem id="menu_app_dashboard_general"
              name="Ventas General"
              parent="menu_app_dashboard"
              action="action_bd_app_dashboard"
              sequence="10"/>

    <menuitem id="menu_app_dashboard_warehouse"
              name="Por Sucursal"
              parent="menu_app_dashboard"
              action="action_bd_app_dashboard_warehouse"
              sequence="20"/>

    <menuitem id="menu_app_dashboard_states"
              name="Estados Fulfillment"
              parent="menu_app_dashboard"
              action="action_bd_app_dashboard_states"
              sequence="30"/>

    <menuitem id="menu_app_dashboard_payments"
              name="Análisis de Pagos"
              parent="menu_app_dashboard"
              action="action_bd_app_dashboard_payments"
              sequence="40"/>

    <!-- ─── Logs ─────────────────────────────────────────────── -->
    <menuitem id="menu_app_logs"
              name="Logs"
              parent="menu_app_sales_root"
              action="action_bd_app_logs"
              sequence="25"
              groups="blackdog_app_sales.group_app_sales_manager"/>

    <!-- ─── Importar ─────────────────────────────────────────── -->
    <menuitem id="menu_app_import_wizard"
              name="Importar Pedido (JSON)"
              parent="menu_app_orders"
              action="action_bd_order_import_wizard"
              sequence="40"
              groups="blackdog_app_sales.group_app_sales_manager"/>

    <!-- ─── Configuración ────────────────────────────────────── -->
    <menuitem id="menu_app_config"
              name="Configuración"
              parent="menu_app_sales_root"
              action="action_bd_app_config_open"
              sequence="99"
              groups="blackdog_app_sales.group_app_sales_manager"/>

</odoo>
