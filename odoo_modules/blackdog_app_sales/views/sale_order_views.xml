<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Smart button "App Order" en sale.order form -->
    <record id="view_sale_order_form_inherit_app" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.blackdog.app</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_app_orders" type="object"
                        class="oe_stat_button" icon="fa-mobile"
                        invisible="app_order_count == 0">
                    <field name="app_order_count" widget="statinfo"
                           string="App Orders"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
