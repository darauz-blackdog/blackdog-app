<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_app_order_queue_list" model="ir.ui.view">
        <field name="name">blackdog.app.order.queue.list</field>
        <field name="model">blackdog.app.order.queue</field>
        <field name="arch" type="xml">
            <list string="Colas de Pedidos"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'partially_completed'"
                  decoration-success="state == 'completed'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="create_date" string="Fecha"/>
                <field name="total_lines"/>
                <field name="completed_lines"/>
                <field name="failed_lines"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'partially_completed'"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_app_order_queue_form" model="ir.ui.view">
        <field name="name">blackdog.app.order.queue.form</field>
        <field name="model">blackdog.app.order.queue</field>
        <field name="arch" type="xml">
            <form string="Cola de Pedidos">
                <header>
                    <button name="action_process" string="Procesar Cola"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="blackdog_app_sales.group_app_sales_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="total_lines"/>
                            <field name="completed_lines"/>
                            <field name="failed_lines"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="app_ref"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'pending'"
                                           decoration-success="state == 'completed'"
                                           decoration-danger="state == 'failed'"/>
                                    <field name="app_order_id"/>
                                    <field name="error_message" optional="show"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Queue Line Form -->
    <record id="view_app_order_queue_line_form" model="ir.ui.view">
        <field name="name">blackdog.app.order.queue.line.form</field>
        <field name="model">blackdog.app.order.queue.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Cola">
                <header>
                    <button name="action_process" string="Procesar"
                            type="object" class="btn-primary"
                            invisible="state != 'pending'"
                            groups="blackdog_app_sales.group_app_sales_manager"/>
                    <button name="action_retry" string="Reintentar"
                            type="object" class="btn-warning"
                            invisible="state != 'failed'"
                            groups="blackdog_app_sales.group_app_sales_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="queue_id"/>
                            <field name="app_ref"/>
                            <field name="app_order_id"/>
                        </group>
                    </group>
                    <group string="JSON Crudo">
                        <field name="raw_data" nolabel="1" widget="ace"
                               options="{'mode': 'json'}"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"
                               readonly="1" class="text-danger"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTIONS -->
    <record id="action_app_order_queue" model="ir.actions.act_window">
        <field name="name">Cola de Importación</field>
        <field name="res_model">blackdog.app.order.queue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
