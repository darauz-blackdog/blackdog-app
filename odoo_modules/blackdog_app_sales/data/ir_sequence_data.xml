<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_app_order" model="ir.sequence">
            <field name="name">BlackDog App Order</field>
            <field name="code">blackdog.app.order</field>
            <field name="prefix">APP-ORD/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_app_order_queue" model="ir.sequence">
            <field name="name">BlackDog App Order Queue</field>
            <field name="code">blackdog.app.order.queue</field>
            <field name="prefix">APP-Q/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_app_payment" model="ir.sequence">
            <field name="name">BlackDog App Payment</field>
            <field name="code">blackdog.app.payment</field>
            <field name="prefix">APP-PAY/</field>
            <field name="padding">5</field>
        </record>

    </data>
</odoo>
