<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Grupo: Gestor de Pedidos App -->
        <record id="group_app_sales_manager" model="res.groups">
            <field name="name">BlackDog App - Gestor de Pedidos</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('group_app_branch_operator'))]"/>
            <field name="comment">
                Acceso completo a todos los modelos del módulo App Móvil.
                Puede gestionar configuración, procesar colas, y ver todos los pedidos.
            </field>
        </record>

        <!-- Grupo: Operador de Sucursal (fulfillment) -->
        <record id="group_app_branch_operator" model="res.groups">
            <field name="name">BlackDog App - Operador Sucursal</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">
                Puede ver pedidos asignados a su sucursal y actualizar
                el estado de fulfillment. Lectura en cola, pagos y logs.
            </field>
        </record>

    </data>
</odoo>
